<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- כותרת ראשית מעוגנת לחלק העליון -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/israel_title"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- תמונה מעוגנת מתחת לכותרת -->
    <ImageView
        android:id="@+id/ivIsrael"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/israel"
        android:contentDescription="@string/israel_img_desc"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- טקסט הסבר מעוגן מתחת לתמונה -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/israel_desc"
        android:textSize="18sp"
        android:textColor="@android:color/darker_gray"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/ivIsrael"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- כפתור מעוגן מתחת לטקסט -->
    <Button
        android:id="@+id/btnIsrael"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/israel_btn"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>



